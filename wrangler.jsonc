// みんなの声（民意を集める投票サイト）を Cloudflare Workers + D1 で公開する設定
{
  "name": "minnano-koe",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // console.error などの記録を Cloudflare のダッシュボード（Workers → minnano-koe → ログ）で見られるようにする
  "observability": { "enabled": true },
  // election.support で公開する（ドメインが同じ Cloudflare アカウントに追加済みであること）
  "routes": [{ "pattern": "election.support", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // /api/* だけ Worker で処理し、それ以外は静的ファイルを返す
    // /p/<番号> は SNS でシェアするときのアドレス（テーマごとのタイトル・画像を返してからテーマのページへ移る）
    "run_worker_first": ["/api/*", "/p/*", "/sitemap.xml"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minnano-koe",
      // `npx wrangler d1 create minnano-koe` で表示された ID に置き換える
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    // 持ち越せる票の上限（溜め込みすぎ防止）
    "MAX_BALANCE": "3",
    // 属性別・かけ合わせの集計で、これより少ない人数の区分は表示しない
    "MIN_GROUP_SIZE": "5"
  }
  // 秘密の値は `npx wrangler secret put <名前>` で設定する（ここには書かない）
  //   ADMIN_TOKEN         管理画面のパスワード
  //   PHONE_PEPPER        LINE の利用者 ID を HMAC する鍵（一度決めたら変えない）
  //   LINE_CHANNEL_ID / LINE_CHANNEL_SECRET、TURNSTILE_SITE_KEY / TURNSTILE_SECRET_KEY
}
